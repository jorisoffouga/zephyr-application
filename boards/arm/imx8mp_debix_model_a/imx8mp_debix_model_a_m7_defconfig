CONFIG_CLOCK_CONTROL=y
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
# Console in RAM, read by Linux: /sys/kernel/debug/remoteproc/remoteproc0/trace0
# (resource table trace entry). For the UART3 console instead:
# CONFIG_RAM_CONSOLE=n, CONFIG_UART_CONSOLE=y
CONFIG_RAM_CONSOLE=y
CONFIG_RAM_CONSOLE_BUFFER_SIZE=1024
CONFIG_UART_CONSOLE=n
CONFIG_XIP=y
CONFIG_CODE_ITCM=y
CONFIG_PINCTRL=y
