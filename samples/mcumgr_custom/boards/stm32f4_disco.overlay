/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * STM32F4DISCOVERY (STM32F407G-DISC1) + MikroElektronika STM32F4 Discovery
 * Shield (MIKROE-1481), from the shield schematic (user manual v1.00):
 *
 *            mikroBUS 1      mikroBUS 2      mikroBUS 3        mikroBUS 4
 *   AN       PC1             PC2             PC5               PB0
 *   RST      PE10            PE12            PE4               PD6
 *   CS       PB12            PE14            PE5               PD7
 *   SPI      SPI2 PB13/14/15 SPI2 PB13/14/15 SPI3 PB3/4/5      SPI3 PB3/4/5
 *   PWM      PA1             PE13            PB1 (TIM3_CH4)    PC8
 *   INT      PE7             PE8             PD2               PC11
 *   UART     USART3 PB10/11  USART3 PB10/11  USART6 PC6/7      USART6 PC6/7
 *   I2C      I2C1 PB8/PB7    I2C1 PB8/PB7    I2C3 PA8/PC9      I2C3 PA8/PC9
 *
 * SMP runs on USART2 (PA2 TX, PA3 RX), wired to the shield FT232RL USB-UART
 * (mini-B connector, /dev/ttyUSB0 on the host). USART2 carries only SMP
 * frames (and the MCUboot boot log).
 *
 * Console, printk and Zephyr logs: USB CDC ACM on the Discovery micro-USB
 * OTG connector (CN5, PA11/PA12), /dev/ttyACM* on the host ("mcumgr_custom
 * log"). Logs never mix with the SMP frames.
 *
 * Click boards of this setup:
 *   mikroBUS 1: EEPROM click (MIKROE-1200): ST 24C08, 1 KiB, I2C1 @ 0x50..0x53
 *               (one address per 256-byte block), WP = PWM pin PA1
 *   mikroBUS 2: MCP23S08 GPIO expander (SPI2) driving 8 LEDs, active low
 *   mikroBUS 3: Air Quality 3 click (CCS811), I2C3 @ 0x5a
 *
 * Other click boards, as extra overlays (boards/clicks/, see README.md):
 *   bargraph_slot3.overlay  BarGraph click on mikroBUS 3 (instead of the
 *                           Air Quality 3 click)
 *   alcohol_slot1.overlay   Alcohol click on mikroBUS 1 (instead of the
 *                           EEPROM click), with alcohol_slot1.conf
 *
 * LED indexes of the "led" SMP group, in this order:
 *   0..3   board LEDs (led0..led3 aliases: green, orange, red, blue)
 *   4..11  expander_leds (exp0..exp7)
 *   then   bargraph_leds (bar0..bar9) with bargraph_slot3.overlay
 */

#include "stm32f4_disco_partitions.dtsi"

/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
		zephyr,uart-mcumgr = &usart2;
		zephyr,console = &cdc_acm_log;
		zephyr,shell-uart = &cdc_acm_log;
	};

	aliases {
		eeprom-0 = &eeprom;
	};

	/*
	 * mikroBUS 2: one LED per MCP23S08 pin, lit when the pin is low.
	 * Change GPIO_ACTIVE_LOW to GPIO_ACTIVE_HIGH if the board is wired
	 * the other way.
	 */
	expander_leds: expander-leds {
		compatible = "gpio-leds";

		exp-led-0 { gpios = <&mcp23s08 0 GPIO_ACTIVE_LOW>; label = "exp0"; };
		exp-led-1 { gpios = <&mcp23s08 1 GPIO_ACTIVE_LOW>; label = "exp1"; };
		exp-led-2 { gpios = <&mcp23s08 2 GPIO_ACTIVE_LOW>; label = "exp2"; };
		exp-led-3 { gpios = <&mcp23s08 3 GPIO_ACTIVE_LOW>; label = "exp3"; };
		exp-led-4 { gpios = <&mcp23s08 4 GPIO_ACTIVE_LOW>; label = "exp4"; };
		exp-led-5 { gpios = <&mcp23s08 5 GPIO_ACTIVE_LOW>; label = "exp5"; };
		exp-led-6 { gpios = <&mcp23s08 6 GPIO_ACTIVE_LOW>; label = "exp6"; };
		exp-led-7 { gpios = <&mcp23s08 7 GPIO_ACTIVE_LOW>; label = "exp7"; };
	};
};

/*
 * mikroBUS 1 and 2 I2C: I2C1 on PB8 (SCL) / PB7 (SDA). The board default is
 * PB6 / PB9 for the CS43L22 audio codec, which is disconnected (disabled).
 */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	/*
	 * mikroBUS 1: EEPROM click, ST M24C08 (8 Kbit): 4 blocks of 256 bytes,
	 * block n at I2C address 0x50 + n (the driver picks the address from
	 * the offset). ADDR jumper (E2) assumed on 0: 0x50..0x53; on 1 it is
	 * 0x54..0x57, use reg = <0x54>.
	 * WP (write control, high = protected) assumed on the mikroBUS PWM pin
	 * PA1: the driver drives it low only while it writes. If the writes
	 * fail ("eeprom write ... IO"), check that pin on the click.
	 * src/app_store.c keeps the LED settings in the last block (0x300).
	 */
	eeprom: eeprom@50 {
		compatible = "st,m24xxx", "atmel,at24";
		reg = <0x50>;
		size = <1024>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
		wp-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
	};
};

&audio_codec {
	status = "disabled";
};

/*
 * mikroBUS 3 and 4 I2C: I2C3 on PA8 (SCL) / PC9 (SDA).
 */
&i2c3 {
	pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pc9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	/*
	 * mikroBUS 3: Air Quality 3 click, ADDR jumper on 0 = 0x5a (0x5b if
	 * the jumper is on 1: "smp_client.py airq --diag" shows which one
	 * answers). Deferred init: src/airq_mgmt.c initializes the driver about
	 * 2.5 s after boot, when the USB log is up, and logs the result.
	 */
	ccs811: ccs811@5a {
		compatible = "ams,ccs811";
		reg = <0x5a>;
		zephyr,deferred-init;
		reset-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;	/* RST */
		wake-gpios = <&gpioe 5 GPIO_ACTIVE_LOW>;	/* CS */
		irq-gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;		/* INT */
	};
};

/* same peripheral as SPI3 (BarGraph click overlay), at the same address */
&i2s3 {
	status = "disabled";
};

/* Discovery micro-USB OTG (CN5): console and logs */
&zephyr_udc0 {
	cdc_acm_log: cdc_acm_log {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* mikroBUS 2: MCP23S08 on SPI2, CS PE14 */
&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 14 GPIO_ACTIVE_LOW>;
	status = "okay";

	mcp23s08: gpio@0 {
		compatible = "microchip,mcp23s08";
		reg = <0>;
		spi-max-frequency = <1000000>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		/* if the expander RESET pin is wired to mikroBUS 2 RST: */
		/* reset-gpios = <&gpioe 12 GPIO_ACTIVE_LOW>; */
	};
};
