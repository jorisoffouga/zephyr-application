/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * STM32F4DISCOVERY (STM32F407G-DISC1) + MikroElektronika STM32F4 Discovery
 * Shield (MIKROE-1481), from the shield schematic (user manual v1.00):
 *
 *            mikroBUS 1      mikroBUS 2      mikroBUS 3        mikroBUS 4
 *   AN       PC1             PC2             PC5               PB0
 *   RST      PE10            PE12            PE4               PD6
 *   CS       PB12            PE14            PE5               PD7
 *   SPI      SPI2 PB13/14/15 SPI2 PB13/14/15 SPI3 PB3/4/5      SPI3 PB3/4/5
 *   PWM      PA1             PE13            PB1 (TIM3_CH4)    PC8
 *   INT      PE7             PE8             PD2               PC11
 *   UART     USART3 PB10/11  USART3 PB10/11  USART6 PC6/7      USART6 PC6/7
 *   I2C      I2C1 PB8/PB7    I2C1 PB8/PB7    I2C3 PA8/PC9      I2C3 PA8/PC9
 *
 * SMP runs on USART2 (PA2 TX, PA3 RX), wired to the shield FT232RL USB-UART
 * (mini-B connector, /dev/ttyUSB0 on the host). USART2 carries only SMP
 * frames (and the MCUboot boot log).
 *
 * Console, printk and Zephyr logs: USB CDC ACM on the Discovery micro-USB
 * OTG connector (CN5, PA11/PA12), /dev/ttyACM* on the host ("mcumgr_custom
 * log"). Logs never mix with the SMP frames.
 *
 * LED indexes of the "led" SMP group: 0..3 board LEDs (led0..led3
 * aliases: green, orange, red, blue).
 */

#include "stm32f4_disco_partitions.dtsi"

/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
		zephyr,uart-mcumgr = &usart2;
		zephyr,console = &cdc_acm_log;
		zephyr,shell-uart = &cdc_acm_log;
	};
};

/* Discovery micro-USB OTG (CN5): console and logs */
&zephyr_udc0 {
	cdc_acm_log: cdc_acm_log {
		compatible = "zephyr,cdc-acm-uart";
	};
};
